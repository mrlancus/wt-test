// wt-analytics Worker. Deploy: `npm run deploy` (see README). Resource ids are not secrets.
{
  "name": "wt-analytics",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "../web", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // Secret (wrangler secret put API_KEY): the key the helper and the browser log in with.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "wt-analytics" }],
  "d1_databases": [{ "binding": "DB", "database_name": "wt-analytics", "database_id": "326cea19-3358-43b8-b973-f0a0b1ea5fab" }],
  "observability": { "enabled": true }
}
