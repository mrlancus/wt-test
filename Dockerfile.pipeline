# syntax=docker/dockerfile:1
# The cloud pipeline container (src/wt_analytics/pipeline/service.py). Built by `wrangler deploy`.
# Docker Hub's official image via Google's mirror (Docker Hub rate-limits shared build machines).
FROM mirror.gcr.io/library/python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HEAT3D_NO_UPDATE=1
WORKDIR /app
# git: the decoder is pinned to a commit of its repository.
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY src ./src
# `proxy_ca` is only given on build machines behind a TLS-inspecting proxy (see tools/docker-proxy.sh).
RUN --mount=type=secret,id=proxy_ca,required=false \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca GIT_SSL_CAINFO=/run/secrets/proxy_ca; fi; \
    pip install --no-cache-dir ".[pipeline]"

EXPOSE 8080
CMD ["python", "-m", "wt_analytics.pipeline.service"]
